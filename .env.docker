# ── Chroniq — Docker Environment Variables ───────────────────────────────────
# Copy this file to .env.docker.local and fill in your secrets.
# docker compose --env-file .env.docker.local up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=chroniq
POSTGRES_USER=chroniq
POSTGRES_PASSWORD=change_me_strong_password

# ── SMTP (Gmail App Password recommended) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Chroniq

# ── Application ───────────────────────────────────────────────────────────────
# Set to your public domain in production, e.g. https://chroniq.yourdomain.com
FRONTEND_URL=http://localhost
DEFAULT_TIMEZONE=Asia/Kolkata
APP_NAME=Chroniq

# ── Port overrides (optional) ─────────────────────────────────────────────────
# FRONTEND_PORT=80
# BACKEND_PORT=8000
